{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/geroprotector/schemas/assay_observation.schema.json",
  "title": "Observation-level lifespan or geroprotection assay record",
  "description": "Prospective/retrospective endpoint-aligned table. Do not collapse organism, strain, dose, sex, laboratory, or publication before preserving this record.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "observation_id",
    "compound_id",
    "parent_inchikey",
    "organism",
    "assay_type",
    "treatment_group_n",
    "control_group_n",
    "direction",
    "blinded",
    "source_batch_id"
  ],
  "properties": {
    "observation_id": {"type": "string"},
    "compound_id": {"type": "string"},
    "parent_inchikey": {"type": "string"},
    "organism": {"type": "string"},
    "strain": {"type": ["string", "null"]},
    "sex": {"type": ["string", "null"], "enum": ["female", "male", "mixed", "hermaphrodite", "not_applicable", "unknown", null]},
    "laboratory": {"type": ["string", "null"]},
    "publication_id": {"type": ["string", "null"]},
    "assay_type": {"type": "string", "enum": ["lifespan", "healthspan", "senescence", "toxicity", "other_locked"]},
    "dose_value": {"type": ["number", "null"]},
    "dose_unit": {"type": ["string", "null"]},
    "route": {"type": ["string", "null"]},
    "treatment_start_age": {"type": ["number", "null"]},
    "treatment_start_age_unit": {"type": ["string", "null"]},
    "treatment_duration": {"type": ["number", "null"]},
    "treatment_duration_unit": {"type": ["string", "null"]},
    "treatment_group_n": {"type": "integer", "minimum": 1},
    "control_group_n": {"type": "integer", "minimum": 1},
    "median_lifespan_treated": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "median_lifespan_control": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "maximum_lifespan_treated": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "maximum_lifespan_control": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "log_lifespan_ratio": {"type": ["number", "null"]},
    "hazard_ratio": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "p_value": {"type": ["number", "null"], "minimum": 0.0, "maximum": 1.0},
    "multiple_testing_adjusted_p": {"type": ["number", "null"], "minimum": 0.0, "maximum": 1.0},
    "direction": {"type": "string", "enum": ["increase", "null", "decrease", "ambiguous"]},
    "toxicity_observed": {"type": ["boolean", "null"]},
    "blinded": {"type": "boolean"},
    "randomized": {"type": ["boolean", "null"]},
    "replicate_count": {"type": ["integer", "null"], "minimum": 1},
    "source_batch_id": {"type": "string"},
    "protocol_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "qc_flags": {"type": "array", "items": {"type": "string"}}
  }
}
