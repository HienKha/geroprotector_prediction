{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/geroprotector/schemas/metrics.schema.json",
  "title": "Compound-level evaluation summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "pipeline_id",
    "model_id",
    "split_strategy",
    "evaluation_role",
    "aggregation_level",
    "n_compounds",
    "n_positive",
    "n_negative",
    "prevalence_positive",
    "metrics",
    "created_utc"
  ],
  "properties": {
    "run_id": {"type": "string"},
    "pipeline_id": {"type": "string"},
    "model_id": {"type": "string"},
    "reference_model_id": {"type": ["string", "null"]},
    "split_strategy": {"type": "string"},
    "evaluation_role": {"type": "string"},
    "aggregation_level": {"type": "string", "const": "one_final_prediction_per_compound"},
    "n_compounds": {"type": "integer", "minimum": 2},
    "n_positive": {"type": "integer", "minimum": 1},
    "n_negative": {"type": "integer", "minimum": 1},
    "n_primary_components": {"type": ["integer", "null"], "minimum": 1},
    "prevalence_positive": {"type": "number", "minimum": 0.0, "maximum": 1.0},
    "threshold": {"type": ["number", "null"], "minimum": 0.0, "maximum": 1.0},
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ap_positive", "ap_negative", "auroc", "brier"],
      "properties": {
        "ap_positive": {"$ref": "#/$defs/unitIntervalOrNull"},
        "ap_negative": {"$ref": "#/$defs/unitIntervalOrNull"},
        "auroc": {"$ref": "#/$defs/unitIntervalOrNull"},
        "mcc": {"type": ["number", "null"], "minimum": -1.0, "maximum": 1.0},
        "balanced_accuracy": {"$ref": "#/$defs/unitIntervalOrNull"},
        "macro_f1": {"$ref": "#/$defs/unitIntervalOrNull"},
        "sensitivity": {"$ref": "#/$defs/unitIntervalOrNull"},
        "specificity": {"$ref": "#/$defs/unitIntervalOrNull"},
        "precision": {"$ref": "#/$defs/unitIntervalOrNull"},
        "npv": {"$ref": "#/$defs/unitIntervalOrNull"},
        "brier": {"$ref": "#/$defs/unitIntervalOrNull"},
        "brier_skill": {"type": ["number", "null"]},
        "ece_fixed": {"$ref": "#/$defs/nonNegativeOrNull"},
        "ece_adaptive": {"$ref": "#/$defs/nonNegativeOrNull"},
        "calibration_intercept": {"type": ["number", "null"]},
        "calibration_slope": {"type": ["number", "null"]},
        "precision_at_10": {"$ref": "#/$defs/unitIntervalOrNull"},
        "precision_at_20": {"$ref": "#/$defs/unitIntervalOrNull"},
        "precision_at_50": {"$ref": "#/$defs/unitIntervalOrNull"},
        "recall_at_10": {"$ref": "#/$defs/unitIntervalOrNull"},
        "recall_at_20": {"$ref": "#/$defs/unitIntervalOrNull"},
        "recall_at_50": {"$ref": "#/$defs/unitIntervalOrNull"},
        "enrichment_top_1pct": {"$ref": "#/$defs/nonNegativeOrNull"},
        "enrichment_top_5pct": {"$ref": "#/$defs/nonNegativeOrNull"},
        "enrichment_top_10pct": {"$ref": "#/$defs/nonNegativeOrNull"},
        "bedroc_alpha_20": {"$ref": "#/$defs/unitIntervalOrNull"},
        "coverage": {"$ref": "#/$defs/unitIntervalOrNull"}
      }
    },
    "paired_comparison": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["metric", "delta_candidate_minus_reference", "ci_low", "ci_high", "p_two_sided", "bootstrap_unit", "bootstrap_units", "n_resamples", "n_valid_resamples"],
      "properties": {
        "metric": {"type": "string"},
        "delta_candidate_minus_reference": {"type": "number"},
        "ci_low": {"type": "number"},
        "ci_high": {"type": "number"},
        "p_two_sided": {"type": "number", "minimum": 0.0, "maximum": 1.0},
        "superiority_probability": {"type": ["number", "null"], "minimum": 0.0, "maximum": 1.0},
        "bootstrap_unit": {"type": "string", "const": "primary_component"},
        "bootstrap_units": {"type": "integer", "minimum": 2},
        "n_resamples": {"type": "integer", "minimum": 1000},
        "n_valid_resamples": {"type": "integer", "minimum": 1},
        "seed": {"type": "integer"},
        "multiple_testing_adjustment": {"type": ["string", "null"], "enum": ["holm", "none", null]}
      }
    },
    "created_utc": {"type": "string", "format": "date-time"}
  },
  "$defs": {
    "unitIntervalOrNull": {"type": ["number", "null"], "minimum": 0.0, "maximum": 1.0},
    "nonNegativeOrNull": {"type": ["number", "null"], "minimum": 0.0}
  }
}
